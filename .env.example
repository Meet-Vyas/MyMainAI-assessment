# Optional overrides for `docker compose up` (copy to .env). Every value has a dev default in
# infra/docker-compose.yml, so the stack runs without this file.

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789

# Seeded admin. Changing the password and restarting the backend resets it.
ADMIN_EMAIL=admin@ugn.local
ADMIN_PASSWORD=admin12345

# Testing from a phone on your LAN: use your machine's LAN IP for both, then open
# http://<LAN-IP>:5173 on the phone. The first is for uploads, the second for playback.
# S3_PUBLIC_ENDPOINT=http://192.168.1.20:9000
# PUBLIC_MEDIA_BASE_URL=http://192.168.1.20:9000/ugn-videos
