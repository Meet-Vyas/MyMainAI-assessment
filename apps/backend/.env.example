PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://ugn:ugn@localhost:5432/ugn
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-0123456789
JWT_TTL_SECONDS=28800
# Set to true when served over HTTPS.
COOKIE_SECURE=false
ADMIN_EMAIL=admin@ugn.local
ADMIN_PASSWORD=admin12345
# S3 / MinIO. For real AWS: remove S3_ENDPOINT, set S3_FORCE_PATH_STYLE=false and use real
# credentials (or none, to use an IAM role). PUBLIC_MEDIA_BASE_URL becomes the CloudFront URL.
S3_ENDPOINT=http://localhost:9000
# Host browsers use for presigned upload URLs (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ugn-videos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/ugn-videos
UPLOAD_URL_TTL_SECONDS=3600
ABANDONED_UPLOAD_TTL_HOURS=24
