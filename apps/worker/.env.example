REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://ugn:ugn@localhost:5432/ugn
# Jobs processed at once per worker process. Each one is a full ffmpeg ladder encode, so keep 1
# and scale with more worker containers.
WORKER_CONCURRENCY=1
# Scratch space for the downloaded source and HLS output. Wiped on start; needs roughly the source
# size plus the encoded output free (checked before each job).
WORK_DIR=/tmp/ugn
# x264 threads per rendition encoder, and speed/quality preset (ultrafast ... veryslow).
FFMPEG_THREADS=4
FFMPEG_PRESET=veryfast
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ugn-videos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
